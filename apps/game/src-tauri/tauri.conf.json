{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kernel_Panic",
  "version": "0.1.0",
  "identifier": "org.fsociety.kernelpanic",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. scenarios && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../.. scenarios && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kernel_Panic",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#05070b",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Hacking investigation inside a virtual OS",
    "copyright": "© 2026 fsociety",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
