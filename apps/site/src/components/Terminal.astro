---
// Pure-CSS "typing" terminal. Each line is revealed in sequence; no JS.
const lines: { prompt?: boolean; text: string; tone?: string }[] = [
  { prompt: true, text: 'grep -i "accepted" /var/log/auth.log' },
  { text: 'Apr 17 02:47:13 ws-varga sshd[2291]: Accepted password for elias from ███.███.███.██', tone: 'warn' },
  { prompt: true, text: 'ls ~/Maildir/new' },
  { text: '1776406320.M1P4201.ws-varga.eml', tone: 'violet' },
  { prompt: true, text: 'sudo lumenctl status' },
  { text: '[sudo] password for elias:' },
  { text: 'JOB-0417   substation-*   QUEUED   09:00', tone: 'red' },
];
---
<div class="term" role="img" aria-label="Extrait de terminal : un analyste inspecte les journaux d'authentification et découvre un job de firmware en attente.">
  <div class="bar" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="title">elias@ws-varga: ~</span>
  </div>
  <div class="screen" aria-hidden="true">
    {lines.map((l, i) => (
      <div class={`line ${l.tone ?? ''}`} style={`--i:${i}`}>{l.prompt && <span class="p"><b>elias@ws-varga</b>:<em>~</em>$ </span>}<span>{l.text}</span></div>
    ))}
    <div class="line" style={`--i:${lines.length}`}><span class="p"><b>elias@ws-varga</b>:<em>~</em>$ </span><span class="cursor"></span></div>
  </div>
</div>

<style>
  .term {
    background: #070a0f;
    border: 1px solid var(--kp-line-strong);
    border-radius: var(--kp-radius-m);
    box-shadow: var(--kp-shadow-2), var(--kp-shadow-focus);
    overflow: hidden;
    position: relative;
  }
  .term::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(62, 230, 245, 0.5), transparent);
  }
  .bar {
    display: flex; align-items: center; gap: 12px;
    height: 36px; padding: 0 14px;
    background: var(--kp-bg-3);
    border-bottom: 1px solid var(--kp-line);
  }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--kp-bg-4); }
  .title { flex: 1; text-align: center; margin-right: 45px; font: 500 12px var(--kp-font-ui); color: var(--kp-text-1); }
  .screen {
    margin: 0; padding: 16px 18px 20px;
    font: 400 13px/1.7 var(--kp-font-mono);
    color: #c4cedc;
    white-space: pre-wrap; word-break: break-word;
    min-height: 260px;
  }
  .line {
    display: block;
    white-space: pre-wrap;
    opacity: 0;
    animation: reveal 0.01s steps(1) forwards;
    animation-delay: calc(var(--i) * 0.9s + 0.4s);
  }
  .p b { color: var(--kp-green); font-weight: 600; }
  .p em { color: var(--kp-cyan); font-style: normal; }
  .warn { color: var(--kp-amber); }
  .violet { color: var(--kp-violet); }
  .red { color: var(--kp-red); }
  .cursor {
    display: inline-block; width: 8px; height: 1.1em; vertical-align: text-bottom;
    background: var(--kp-cyan);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes reveal { to { opacity: 1; } }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .line { opacity: 1; }
  }
</style>
