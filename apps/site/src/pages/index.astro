---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';

const releases = 'https://github.com/fs0ciety7000/KernelPanic/releases/latest';

const apps = [
  { id: 'files', name: 'Files', tone: 'text', desc: 'Arborescence complète, permissions, propriétaires — et ce qui commence par un point.', icon: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z' },
  { id: 'terminal', name: 'Terminal', tone: 'green', desc: 'Un shell crédible : pipes, redirections, grep, find, base64, sudo. Le scalpel de l’analyste.', icon: 'M4 6l6 6-6 6M12 18h8' },
  { id: 'notes', name: 'Notes', tone: 'text', desc: 'Lire runbooks et scripts, éditer des fichiers, tenir son propre carnet d’enquête.', icon: 'M6 3h9l4 4v14H6zM9 11h7M9 15h7' },
  { id: 'mail', name: 'Mail', tone: 'cyan', desc: 'Une vraie Maildir. Les en-têtes complets racontent le trajet de chaque message.', icon: 'M3 6h18v12H3zM3 7l9 6 9-6' },
  { id: 'images', name: 'Images', tone: 'violet', desc: 'Zoom, métadonnées EXIF. Une photo de bureau peut en dire beaucoup trop.', icon: 'M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4M15 9h.01' },
  { id: 'logs', name: 'Logs', tone: 'amber', desc: 'Journaux colorés par niveau, filtres regex, saut à l’horodatage. La nuit, minute par minute.', icon: 'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5' },
  { id: 'case', name: 'Case', tone: 'violet', desc: 'Le dossier d’enquête : objectifs, réponses, indices, rapport final.', icon: 'M5 4h14v16H5zM9 9l2 2 4-4M9 15h6' },
];

const pillars = [
  { k: '01', t: 'Un OS, pas un décor', d: 'Fenêtres, explorateur, terminal, mails : tout fonctionne et tout est cohérent. Ce que vous voyez dans une app, vous pouvez le retrouver au terminal.' },
  { k: '02', t: 'Des techniques crédibles', d: 'Lire des en-têtes de mails, recouper des journaux, traquer une persistance, décoder un script. Du vrai savoir-faire, sans vrai exploit.' },
  { k: '03', t: 'Une enquête, pas un QCM', d: 'Les indices sont dispersés dans la machine. Chaque objectif a plusieurs chemins : à vous de choisir le vôtre.' },
];
---
<Base>
  <header class="nav">
    <div class="wrap nav-in">
      <a class="logo" href="/" aria-label="Kernel_Panic — accueil">KP<span>_</span></a>
      <nav aria-label="Navigation principale">
        <a href="#concept">Concept</a>
        <a href="#apps">Applications</a>
        <a href="#scenario">Scénario</a>
        <a href="#download">Télécharger</a>
      </nav>
      <a class="btn btn-primary nav-cta" href="/play/">Jouer</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <p class="label">Jeu d'enquête · Hacking · OS virtuel</p>
          <h1 class="wordmark">Kernel<span class="us">_</span>Panic</h1>
          <p class="tagline">Une machine compromise. Une nuit de logs. Personne d'autre que vous pour comprendre ce qui s'est passé.</p>
          <div class="ctas">
            <a class="btn btn-primary" href="/play/">Jouer dans le navigateur <span aria-hidden="true">→</span></a>
            <a class="btn btn-secondary" href="#download">Télécharger</a>
          </div>
          <p class="meta mono">web · macOS · Windows · Linux — gratuit, sans inscription</p>
        </div>
        <div class="hero-term">
          <Terminal />
        </div>
      </div>
    </section>

    <section id="concept" class="section">
      <div class="wrap">
        <p class="label">Concept</p>
        <h2>Vous n'incarnez pas un hacker de film.<br /><span class="muted">Vous êtes l'analyste qu'on appelle après.</span></h2>
        <div class="pillars">
          {pillars.map((p) => (
            <article class="pillar">
              <span class="k mono">{p.k}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="apps" class="section">
      <div class="wrap">
        <p class="label">Applications système</p>
        <h2>Sept outils. Une seule machine.</h2>
        <ul class="apps">
          {apps.map((a) => (
            <li class={`app tone-${a.tone}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={a.icon} /></svg>
              <h3>{a.name}</h3>
              <p>{a.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="scenario" class="section">
      <div class="wrap scenario">
        <div>
          <p class="label">Scénario 01 · débutant / intermédiaire · ~35 min</p>
          <h2>Ghost Shift</h2>
          <p class="lede">Lumen Grid exploite le réseau électrique de Valmont. Cette nuit, à <b class="mono">03:12</b>, une mise à jour de firmware que personne n'a demandée a été mise en file d'attente sur les sous-stations — depuis le compte d'<b>Elias Varga</b>, administrateur système. Elias ne répond plus.</p>
          <p class="lede">On vous ouvre sa session. Le job s'exécute à 09:00.</p>
          <a class="btn btn-primary" href="/play/">Ouvrir la session <span aria-hidden="true">→</span></a>
        </div>
        <aside class="dossier" aria-label="Fiche incident">
          <dl class="mono">
            <div><dt>Incident</dt><dd>LG-2026-0417</dd></div>
            <div><dt>Machine</dt><dd>ws-varga.lumengrid.local</dd></div>
            <div><dt>Job</dt><dd class="red">JOB-0417 · QUEUED</dd></div>
            <div><dt>Mise en file</dt><dd>03:12</dd></div>
            <div><dt>Exécution</dt><dd class="amber">09:00</dd></div>
            <div><dt>Compte</dt><dd>elias</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section id="download" class="section">
      <div class="wrap">
        <p class="label">Télécharger</p>
        <h2>Natif, léger, hors ligne.</h2>
        <p class="lede">Les versions desktop embarquent le même OS que la version web, dans une application de quelques mégaoctets.</p>
        <div class="dl">
          <a class="dl-card" href={releases}><span class="os">macOS</span><span class="mono">Apple Silicon & Intel · .dmg</span></a>
          <a class="dl-card" href={releases}><span class="os">Windows</span><span class="mono">10 / 11 · .msi</span></a>
          <a class="dl-card" href={releases}><span class="os">Linux</span><span class="mono">.AppImage · .deb</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap foot-in">
      <span class="logo small">Kernel<span>_</span>Panic</span>
      <span class="mono muted">Fiction. Aucun système réel n'a été compromis pendant la fabrication de ce jeu.</span>
      <span class="mono muted">kernel.fs0ciety.org</span>
    </div>
  </footer>
</Base>

<style>
  .nav {
    position: sticky; top: 0; z-index: 10;
    background: rgba(5, 7, 11, 0.72);
    backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid var(--kp-line);
  }
  .nav-in { display: flex; align-items: center; gap: 24px; height: 60px; }
  .nav nav { display: flex; gap: 22px; margin-left: auto; }
  .nav nav a { color: var(--kp-text-1); font-size: 14px; }
  .nav nav a:hover { color: var(--kp-text-0); text-decoration: none; }
  .nav-cta { height: 34px; padding: 0 14px; }
  .logo { font: 700 18px var(--kp-font-ui); color: var(--kp-text-0); letter-spacing: -0.02em; }
  .logo span, .us { color: var(--kp-cyan); animation: blink 1s steps(1) infinite; }
  .logo:hover { text-decoration: none; }

  .hero { padding: clamp(56px, 10vw, 120px) 0 clamp(48px, 8vw, 96px); }
  .hero-in { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .wordmark { font-size: clamp(48px, 8vw, 96px); font-weight: 700; letter-spacing: -0.04em; margin: 16px 0 20px; }
  .tagline { font-size: clamp(17px, 1.6vw, 20px); color: var(--kp-text-1); max-width: 34ch; margin: 0 0 32px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .meta { margin-top: 20px; font-size: 12px; color: var(--kp-text-2); }

  .section { padding: clamp(56px, 9vw, 112px) 0; border-top: 1px solid var(--kp-line); }
  .section h2 { font-size: clamp(28px, 4vw, 44px); margin: 14px 0 0; max-width: 24ch; }
  .muted { color: var(--kp-text-2); }
  .lede { max-width: 60ch; font-size: 17px; }

  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
  .pillar { padding: 24px; background: var(--kp-bg-2); border: 1px solid var(--kp-line); border-radius: var(--kp-radius-m); }
  .pillar .k { color: var(--kp-violet); font-size: 12px; }
  .pillar h3 { font-size: 18px; margin: 12px 0 8px; }
  .pillar p { margin: 0; font-size: 15px; }

  .apps { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .app {
    --tone: var(--kp-text-1);
    padding: 20px; border-radius: var(--kp-radius-m);
    background: var(--kp-bg-2); border: 1px solid var(--kp-line);
    transition: border-color var(--kp-dur) var(--kp-ease), transform var(--kp-dur) var(--kp-ease);
  }
  .app:hover { border-color: var(--kp-line-strong); transform: translateY(-2px); }
  .app svg { width: 28px; height: 28px; fill: none; stroke: var(--tone); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .app h3 { font-size: 16px; margin: 14px 0 6px; }
  .app p { margin: 0; font-size: 14px; }
  .tone-cyan { --tone: var(--kp-cyan); }
  .tone-violet { --tone: var(--kp-violet); }
  .tone-green { --tone: var(--kp-green); }
  .tone-amber { --tone: var(--kp-amber); }

  .scenario { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; }
  .scenario .lede b { color: var(--kp-text-0); }
  .scenario .btn { margin-top: 12px; }
  .dossier {
    padding: 24px; border-radius: var(--kp-radius-m);
    background: var(--kp-bg-2); border: 1px solid var(--kp-line);
    border-left: 2px solid var(--kp-violet);
  }
  .dossier dl { margin: 0; display: grid; gap: 12px; font-size: 13px; }
  .dossier div { display: flex; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--kp-line); padding-bottom: 10px; }
  .dossier div:last-child { border: 0; padding: 0; }
  .dossier dt { color: var(--kp-text-2); text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; }
  .dossier dd { margin: 0; color: var(--kp-text-0); }
  .red { color: var(--kp-red) !important; }
  .amber { color: var(--kp-amber) !important; }

  .dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 36px; }
  .dl-card {
    display: flex; flex-direction: column; gap: 6px; padding: 22px;
    border-radius: var(--kp-radius-m); background: var(--kp-bg-2); border: 1px solid var(--kp-line);
    color: var(--kp-text-1); transition: border-color var(--kp-dur) var(--kp-ease);
  }
  .dl-card:hover { text-decoration: none; border-color: var(--kp-cyan); }
  .dl-card .os { font-size: 18px; font-weight: 600; color: var(--kp-text-0); }
  .dl-card .mono { font-size: 12px; color: var(--kp-text-2); }

  .footer { border-top: 1px solid var(--kp-line); padding: 32px 0; }
  .foot-in { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; font-size: 12px; }
  .logo.small { font-size: 15px; }

  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 900px) {
    .hero-in, .scenario { grid-template-columns: 1fr; gap: 40px; }
    .pillars, .dl { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .nav nav { display: none; }
    .nav-cta { margin-left: auto; }
  }
</style>
