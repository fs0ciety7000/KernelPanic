# Lumen Grid — OT workstation sshd configuration
# Managed by IT. Exception OT-2025-31: vendor remote maintenance (port-forward on edge fw)

Port 22
ListenAddress 0.0.0.0
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

# TODO(IT): disable once vendor moves to the bastion — ticket IT-4471
PasswordAuthentication yes

KbdInteractiveAuthentication no
UsePAM yes
X11Forwarding no
PrintMotd yes
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
