{
  "name": "kernel-panic",
  "private": true,
  "version": "0.1.0",
  "description": "Kernel_Panic — hacking investigation game running inside a virtual OS",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm scenarios && pnpm --filter @kp/game dev",
    "build": "pnpm scenarios && pnpm -r --filter=!@kp/server build",
    "scenarios": "pnpm --filter @kp/scenario-kit cli build ../../scenarios ../../apps/game/static/scenarios",
    "scenarios:check": "pnpm --filter @kp/scenario-kit cli validate ../../scenarios",
    "test": "pnpm -r test",
    "check": "pnpm -r check",
    "site:dev": "pnpm --filter @kp/site dev",
    "tauri": "pnpm --filter @kp/game tauri"
  }
}
